# true  = use the built-in mock API (no backend needed)
# false = call the real FastAPI backend through the Vite proxy
VITE_USE_MOCK=true
# Base path of the API. Keep /api when using the Vite proxy.
VITE_API_BASE_URL=/api
# Where "Contact an academic advisor" points to
VITE_ADVISOR_URL=mailto:advisor@example.edu
